generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BankAccountType {
  COURANT
  LIVRET
  PRO
  JOINT
  AUTRE
}

model Household {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members      User[]
  bankAccounts BankAccount[]
}

model User {
  id                       String   @id @default(cuid())
  email                    String   @unique
  passwordHash             String
  firstName                String
  createdAt                DateTime @default(now())

  // Reglage de confidentialite : partager le detail de ses comptes
  // individuels avec le reste du foyer, ou seulement les totaux consolides.
  shareDetailsWithHousehold Boolean @default(true)

  household   Household? @relation(fields: [householdId], references: [id])
  householdId String?

  bankAccounts         BankAccount[]
  budgetTemplate       BudgetTemplate?
  emergencyFundProfile EmergencyFundProfile?
  wastefulRules        WastefulRule[]
}

model BankAccount {
  id             String          @id @default(cuid())
  name           String
  type           BankAccountType
  initialBalance Decimal         @default(0) @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())

  // Compte personnel : rattache a un utilisateur.
  // Compte joint (type = JOINT) : owner est null, seul le foyer est renseigne.
  owner   User?   @relation(fields: [ownerId], references: [id])
  ownerId String?

  household   Household @relation(fields: [householdId], references: [id])
  householdId String

  incomes  Income[]
  expenses Expense[]
}

model Income {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  source    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId String

  @@index([bankAccountId, year, month])
}

enum BudgetMethod {
  CONFORTABLE_50_30_20
  TENDUE_60_25_15
  TRES_TENDUE_70_20_10
  BASE_ZERO
  QUATRE_VINGT_VINGT
  CASCADES_3
}

enum BudgetCategory {
  BESOINS
  ENVIES
  EPARGNE
}

// Budget de reference (un par utilisateur), construit une fois et utilise
// comme comparaison pour le budget reel du mois (fonctionnalite a venir).
model BudgetTemplate {
  id            String       @id @default(cuid())
  method        BudgetMethod
  monthlyIncome Decimal      @db.Decimal(12, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  items BudgetItem[]
}

// Poste de depense type. Un poste peut avoir des sous-depenses (parentId) :
// dans ce cas son montant affiche est la somme de ses enfants plutot que
// monthlyAmount.
model BudgetItem {
  id            String         @id @default(cuid())
  category      BudgetCategory
  name          String
  monthlyAmount Decimal        @default(0) @db.Decimal(12, 2)
  essential     Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())

  template   BudgetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  parent   BudgetItem?  @relation("SubItems", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children BudgetItem[] @relation("SubItems")

  @@index([templateId, category])
}

// Depense reellement engagee pour un mois donne. "poste" est un libelle libre
// (avec suggestions cote frontend issues du budget type) plutot qu'une
// reference stricte a un BudgetItem, pour rester rapide a saisir au quotidien.
model Expense {
  id        String         @id @default(cuid())
  year      Int
  month     Int
  poste     String
  category  BudgetCategory
  amount    Decimal        @db.Decimal(12, 2)
  note      String?
  createdAt DateTime       @default(now())

  // Marquage "depense inutile" (achat impulsif / faible valeur percue).
  // wastefulReviewed = l'utilisateur a explicitement valide/corrige ce
  // marquage pour cette depense precise (elle n'est alors plus recalculee
  // par une regle apprise sur le poste).
  wasteful         Boolean @default(false)
  wastefulReviewed Boolean @default(false)

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId String

  @@index([bankAccountId, year, month])
}

// Regle apprise a partir des corrections de l'utilisateur : quand il
// marque un poste comme utile/inutile, on retient ce choix pour l'appliquer
// automatiquement aux prochaines depenses du meme poste.
model WastefulRule {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  posteKey String
  wasteful Boolean

  updatedAt DateTime @updatedAt

  @@unique([userId, posteKey])
}

// Reponses au questionnaire de vulnerabilite financiere (une par utilisateur)
// + reglages manuels pour le suivi de l'epargne de precaution.
model EmergencyFundProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Chaque critere vaut 1, 3 ou 5 points (voir constants/emergencyFund.ts).
  jobStability      Int
  dependentsLoad    Int
  health            Int
  alternativeIncome Int
  debtLevel         Int

  // Nombre de mois cible : si non renseigne, derive automatiquement du score.
  monthsOverride Int?

  currentSavedAmount             Decimal  @default(0) @db.Decimal(12, 2)
  monthlySavingsCapacityOverride Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  envelopes SavingsEnvelope[]
}

// Repartition de la capacite d'epargne mensuelle entre plusieurs enveloppes
// (livret, assurance vie...).
model SavingsEnvelope {
  id                String   @id @default(cuid())
  name              String
  monthlyAllocation Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  profile   EmergencyFundProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
}
