generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BankAccountType {
  COURANT
  LIVRET
  PRO
  JOINT
  AUTRE
}

model Household {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  // Reglage de repartition des charges communes : mode choisi et valeurs
  // personnalisees (pourcentages ou montants fixes par membre) pour les
  // modes qui en ont besoin. Cle = userId, valeur = pourcentage ou montant.
  splitMode         String @default("PRORATA_REVENUS")
  splitCustomShares Json?

  // Reglages generaux du foyer.
  currency            String @default("EUR")
  fiscalYearStartMonth Int   @default(1)

  members      User[]
  bankAccounts BankAccount[]
  monthlyGoals MonthlyGoal[]
}

// Petits objectifs que le foyer se fixe pour le mois ("Nos victoires"),
// coches au fur et a mesure. Partages entre les membres du foyer.
model MonthlyGoal {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  label     String
  emoji     String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  @@index([householdId, year, month])
}

model User {
  id                       String   @id @default(cuid())
  email                    String   @unique
  passwordHash             String
  firstName                String
  createdAt                DateTime @default(now())

  // Reglage de confidentialite : partager le detail de ses comptes
  // individuels avec le reste du foyer, ou seulement les totaux consolides.
  shareDetailsWithHousehold Boolean @default(true)

  // Authentification a deux facteurs (TOTP). twoFactorSecret est renseigne
  // des l'etape de configuration mais twoFactorEnabled ne passe a true
  // qu'une fois le premier code verifie.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  household   Household? @relation(fields: [householdId], references: [id])
  householdId String?

  bankAccounts         BankAccount[]
  budgetTemplate       BudgetTemplate?
  emergencyFundProfile EmergencyFundProfile?
  feelingRules         FeelingRule[]
  subscriptions        Subscription[]
  recurringCharges     RecurringCharge[]
  wealthItems          WealthItem[]
  savingsGoals         SavingsGoal[]
  correctionLogs       CorrectionLog[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  loans                Loan[]
  provisions           Provision[]
  goalContributions    GoalContribution[]
  importCategoryMemory ImportCategoryMemory[]
  expenseAssignments   ExpenseAssignment[]
  monthlyBudgetOverrides MonthlyBudgetOverride[]
}

model BankAccount {
  id             String          @id @default(cuid())
  name           String
  type           BankAccountType
  initialBalance Decimal         @default(0) @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())

  // Compte personnel : rattache a un utilisateur.
  // Compte joint (type = JOINT) : owner est null, seul le foyer est renseigne.
  owner   User?   @relation(fields: [ownerId], references: [id])
  ownerId String?

  household   Household @relation(fields: [householdId], references: [id])
  householdId String

  incomes          Income[]
  expenses         Expense[]
  recurringCharges RecurringCharge[]
  transfersOut     Transfer[]          @relation("TransferFrom")
  transfersIn      Transfer[]          @relation("TransferTo")
  balanceCheckpoints BalanceCheckpoint[]
  envelopes          AccountEnvelope[]
}

// Enveloppe virtuelle (spec section 18) : reserve mentalement une partie
// du solde d'un compte, sans deplacement bancaire reel. Le total des
// enveloppes d'un compte est compare au solde par l'API a chaque lecture
// (jamais stocke en dur), pour ne jamais cacher un depassement.
model AccountEnvelope {
  id        String   @id @default(cuid())
  name      String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId String

  @@index([bankAccountId])
}

// Point de rapprochement bancaire (spec section 68) : l'utilisateur declare
// le solde constate sur son releve pour un mois donne ; Atlas compare ce
// solde a celui attendu (dernier point + revenus - depenses +/- transferts
// du mois) et signale l'ecart au lieu de le cacher. expectedBalance/
// discrepancy restent null pour le tout premier point d'un compte (rien a
// comparer, ce point devient l'ancre de depart).
model BalanceCheckpoint {
  id              String   @id @default(cuid())
  year            Int
  month           Int
  statedBalance   Decimal  @db.Decimal(12, 2)
  expectedBalance Decimal? @db.Decimal(12, 2)
  discrepancy     Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId String

  @@unique([bankAccountId, year, month])
  @@index([bankAccountId, year, month])
}

model Income {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  source    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId String

  @@index([bankAccountId, year, month])
}

// Virement compte a compte (ex. Compte courant -> Livret A, ou Compte
// Nicolas -> compte joint) : n'est ni un revenu ni une depense au niveau
// du foyer, donc jamais insere dans Income/Expense — l'exclusion des
// totaux du foyer est garantie par construction plutot que par un filtre
// applique a chaque calcul (Lot 3, spec 4.2).
model Transfer {
  id     String   @id @default(cuid())
  amount Decimal  @db.Decimal(12, 2)
  date   DateTime
  note   String?

  fromAccount   BankAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  fromAccountId String

  toAccount   BankAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  toAccountId String

  createdAt DateTime @default(now())

  @@index([fromAccountId])
  @@index([toAccountId])
}

enum BudgetMethod {
  CONFORTABLE_50_30_20
  TENDUE_60_25_15
  TRES_TENDUE_70_20_10
  BASE_ZERO
  QUATRE_VINGT_VINGT
  CASCADES_3
}

// Ressenti sur une depense : remplace l'ancien marquage binaire
// "depense inutile" par une nuance a 3 etats, moins jugeante.
enum ExpenseFeeling {
  SATISFAIT
  NEUTRE
  REGRET
}

// Nature budgetaire d'une depense reelle. BESOINS/ENVIES/EPARGNE alimentent
// la repartition du budget type (methodes 50/30/20 et similaires) ;
// INVESTISSEMENT et REMBOURSEMENT_DETTE sont des natures supplementaires
// pour les depenses reelles qui ne rentrent pas dans ce barème (Lot 3,
// spec 4.2/section 9) — pas de poste cible associe pour l'instant.
enum BudgetCategory {
  BESOINS
  ENVIES
  EPARGNE
  INVESTISSEMENT
  REMBOURSEMENT_DETTE
}

// Budget de reference (un par utilisateur), construit une fois et utilise
// comme comparaison pour le budget reel du mois (fonctionnalite a venir).
model BudgetTemplate {
  id            String       @id @default(cuid())
  method        BudgetMethod
  monthlyIncome Decimal      @db.Decimal(12, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  items BudgetItem[]
}

// Poste de depense type. Un poste peut avoir des sous-depenses (parentId) :
// dans ce cas son montant affiche est la somme de ses enfants plutot que
// monthlyAmount.
model BudgetItem {
  id            String         @id @default(cuid())
  category      BudgetCategory
  name          String
  monthlyAmount Decimal        @default(0) @db.Decimal(12, 2)
  essential     Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())

  template   BudgetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  parent   BudgetItem?  @relation("SubItems", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children BudgetItem[] @relation("SubItems")

  @@index([templateId, category])
}

// Ajustement ponctuel de la cible d'un mois precis pour une categorie
// (colonne "Ce mois" de Mon mois, spec 4.2) : peut differer de la
// Reference (le budget type) sans la modifier. Absence de ligne = la
// cible du mois est simplement celle de la Reference.
model MonthlyBudgetOverride {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  year     Int
  month    Int
  category BudgetCategory
  amount   Decimal        @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt

  @@unique([userId, year, month, category])
}

// Depense reellement engagee pour un mois donne. "poste" est un libelle libre
// (avec suggestions cote frontend issues du budget type) plutot qu'une
// reference stricte a un BudgetItem, pour rester rapide a saisir au quotidien.
model Expense {
  id        String         @id @default(cuid())
  year      Int
  month     Int
  poste     String
  category  BudgetCategory
  amount    Decimal        @db.Decimal(12, 2)
  note      String?
  createdAt DateTime       @default(now())

  // Ressenti sur la depense (achat regrette, neutre, ou dont on est
  // satisfait) : remplace l'ancien marquage binaire "depense inutile" par
  // une nuance a 3 etats, moins jugeante. Null = pas encore evalue.
  // feelingReviewed = l'utilisateur a explicitement choisi/corrige ce
  // ressenti pour cette depense precise (elle n'est alors plus recalculee
  // par une regle apprise sur le poste).
  feeling         ExpenseFeeling?
  feelingReviewed Boolean         @default(false)

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId String

  assignment ExpenseAssignment?
  splits     ExpenseSplit[]

  @@index([bankAccountId, year, month])
}

// Decoupage d'une depense en plusieurs categories (spec section 10, ex.
// 80 € besoin / 20 € envie sur un meme achat). Absence de lignes = la
// depense compte pour sa totalite dans sa propre category/amount (cas
// actuel, inchange). Quand des lignes existent, la somme de leurs amount
// doit toujours egaler Expense.amount (verifie cote application, voir
// utils/expenseCategoryTotals.ts).
model ExpenseSplit {
  id        String         @id @default(cuid())
  category  BudgetCategory
  amount    Decimal        @db.Decimal(12, 2)
  note      String?
  createdAt DateTime       @default(now())

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String

  @@index([expenseId])
}

// Repartition "a la carte" des charges communes : chaque depense sur un
// compte joint peut etre attribuee explicitement a un membre du foyer
// plutot que d'etre partagee au prorata.
model ExpenseAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String  @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// Regle apprise a partir des corrections de l'utilisateur : quand il
// choisit un ressenti pour un poste, on retient ce choix pour l'appliquer
// automatiquement aux prochaines depenses du meme poste.
model FeelingRule {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  posteKey String
  feeling  ExpenseFeeling

  updatedAt DateTime @updatedAt

  @@unique([userId, posteKey])
}

// Reponses au questionnaire de vulnerabilite financiere (une par utilisateur)
// + reglages manuels pour le suivi de l'epargne de precaution.
model EmergencyFundProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Chaque critere vaut 1, 3 ou 5 points (voir constants/emergencyFund.ts).
  jobStability      Int
  dependentsLoad    Int
  health            Int
  alternativeIncome Int
  debtLevel         Int
  safetyNet         Int @default(3)
  emotionalComfort  Int @default(3)
  assetLiquidity    Int @default(3)

  // Nombre de mois cible : si non renseigne, derive automatiquement du score.
  monthsOverride Int?

  currentSavedAmount             Decimal  @default(0) @db.Decimal(12, 2)
  monthlySavingsCapacityOverride Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  envelopes SavingsEnvelope[]
}

// Repartition de la capacite d'epargne mensuelle entre plusieurs enveloppes
// (livret, assurance vie...).
model SavingsEnvelope {
  id                String   @id @default(cuid())
  name              String
  monthlyAllocation Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  profile   EmergencyFundProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
}

enum SubscriptionStatus {
  NON_EVALUE
  A_GARDER
  A_SURVEILLER
  A_RESILIER
}

enum UsageFrequency {
  QUOTIDIEN
  HEBDOMADAIRE
  MENSUEL
  RARE
  JAMAIS
}

// Abonnement derive des depenses recurrentes (meme poste, montant stable,
// plusieurs mois consecutifs) : detecte automatiquement, puis enrichi par
// l'utilisateur (usage reel, statut, rappel de resiliation).
model Subscription {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  posteKey      String
  merchantLabel String
  amount        Decimal @db.Decimal(12, 2)

  status         SubscriptionStatus @default(NON_EVALUE)
  lastUsedAt     DateTime?
  usageFrequency UsageFrequency?
  cancelReminderAt DateTime?
  dismissed      Boolean            @default(false)

  firstSeenMonth Int
  firstSeenYear  Int
  lastSeenMonth  Int
  lastSeenYear   Int
  occurrences    Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, posteKey])
}

// Depense annuelle ou irreguliere mais previsible (assurance, taxe
// fonciere, vacances, entretien voiture...), mensualisee pour lisser son
// impact (spec section 17). Le montant mensualise fait partie de
// "l'argent affecte" et est deduit de "l'argent reellement disponible"
// (section 5) — distinct de RecurringCharge, qui est un vrai prelevement
// mensuel a une date fixe plutot qu'une provision lissee.
model Provision {
  id           String   @id @default(cuid())
  label        String
  annualAmount Decimal  @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// Echeance recurrente declaree manuellement (loyer, credit, facture...) :
// utilisee pour le calendrier des echeances et la projection de solde.
model RecurringCharge {
  id         String   @id @default(cuid())
  label      String
  amount     Decimal  @db.Decimal(12, 2)
  dayOfMonth Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([bankAccountId])
  @@index([userId])
}

enum WealthCategory {
  IMMOBILIER
  VEHICULE
  PLACEMENT
  AUTRE_ACTIF
  CREDIT
  AUTRE_DETTE
}

// Element de patrimoine hors comptes bancaires (immobilier, vehicule,
// placement, credit...) : le signe (actif/passif) est derive de la
// categorie, voir constants/wealth.ts.
model Loan {
  id               String    @id @default(cuid())
  label            String
  principalAmount  Decimal   @db.Decimal(12, 2)
  remainingBalance Decimal   @db.Decimal(12, 2)
  monthlyPayment   Decimal   @db.Decimal(12, 2)
  interestRate     Decimal?  @db.Decimal(5, 2)
  startDate        DateTime
  endDate          DateTime?
  paidOff          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  payments LoanPayment[]

  @@index([userId])
}

// Mensualite enregistree pour un pret (spec section 34) : seule la part
// capital reduit Loan.remainingBalance et compte comme dette remboursee
// (construction de patrimoine) — interets et assurance sont consommes,
// pas rembourses. Avant ce modele, l'ancien endpoint record-payment
// traitait a tort la mensualite entiere comme du capital.
model LoanPayment {
  id               String   @id @default(cuid())
  date             DateTime
  totalAmount      Decimal  @db.Decimal(12, 2)
  principalAmount  Decimal  @db.Decimal(12, 2)
  interestAmount   Decimal  @default(0) @db.Decimal(12, 2)
  insuranceAmount  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId String

  @@index([loanId, date])
}

model WealthItem {
  id        String         @id @default(cuid())
  label     String
  category  WealthCategory
  amount    Decimal        @db.Decimal(12, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  valuations AssetValuation[]

  @@index([userId])
}

enum ValuationSource {
  MANUELLE
  MARCHE
  ESTIMATION
  HISTORIQUE
}

// Historique de valorisation d'un actif (spec section 32) : chaque valeur
// porte sa date et sa nature (saisie manuelle / prix de marche / estimation
// / prix historique), pour ne jamais presenter une estimation comme un
// fait certain (garde-fou section 78) et pour pouvoir, plus tard, separer
// la performance des placements des flux apportes (section 31).
model AssetValuation {
  id            String          @id @default(cuid())
  value         Decimal         @db.Decimal(12, 2)
  valuationDate DateTime
  source        ValuationSource
  note          String?
  createdAt     DateTime        @default(now())

  wealthItem   WealthItem @relation(fields: [wealthItemId], references: [id], onDelete: Cascade)
  wealthItemId String

  @@index([wealthItemId, valuationDate])
}

enum CorrectionType {
  WASTEFUL_EXPENSE
  SUBSCRIPTION_STATUS
  // Une paire depense/revenu detectee comme virement probable (section 9),
  // mais que l'utilisateur a explicitement confirme n'en etre pas un.
  // `detail` porte "expenseId:incomeId" pour ne plus la reproposer.
  TRANSFER_SUGGESTION_DISMISSED
  // Modifications importantes a historiser (section 66) : poste du budget
  // type, montant cible d'un objectif, conditions d'un pret.
  BUDGET_ITEM_MODIFIED
  GOAL_TARGET_MODIFIED
  LOAN_MODIFIED
}

// Journal des corrections manuelles de l'utilisateur (marquage
// utile/inutile, changement de statut d'abonnement...), pour transparence
// et audit : rien ici n'est modifiable, seulement consultable.
model CorrectionLog {
  id        String         @id @default(cuid())
  type      CorrectionType
  label     String
  detail    String?
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
}

// Code de secours 2FA (usage unique) : genere en meme temps que
// l'activation, stocke hache (jamais en clair).
model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// Memorise, par marchand normalise, le poste et la categorie choisis par
// l'utilisateur lors d'un import de releve, pour les reappliquer
// automatiquement la prochaine fois sans qu'il ait a les ressaisir.
model ImportCategoryMemory {
  id          String        @id @default(cuid())
  merchantKey String
  poste       String
  category    BudgetCategory
  updatedAt   DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, merchantKey])
}

// Objectif d'epargne nomme (ex. "Voyage au Japon", "Apport immobilier"),
// distinct de l'epargne de precaution : montant cible, date cible et
// contribution mensuelle prevue sont tous optionnels sauf le montant cible.
model SavingsGoal {
  id                  String    @id @default(cuid())
  name                String
  targetAmount        Decimal   @db.Decimal(12, 2)
  currentAmount       Decimal   @default(0) @db.Decimal(12, 2)
  targetDate          DateTime?
  monthlyContribution Decimal?  @db.Decimal(12, 2)
  // Priorite declaree par l'utilisateur (section 20) : plus petit = plus
  // prioritaire. Null = pas encore classe.
  priority            Int?
  achieved            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  contributions GoalContribution[]

  @@index([userId])
}

// Historique des contributions a un objectif (section 19 : "contributions
// par utilisateur"), pour comparer le rythme prevu (monthlyContribution) au
// rythme reellement observe plutot que de ne garder qu'un total agrege.
model GoalContribution {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  goal   SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([goalId, createdAt])
}
