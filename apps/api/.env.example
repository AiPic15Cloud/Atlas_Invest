# URL de connexion PostgreSQL (fournie automatiquement par Railway en production)
DATABASE_URL="postgresql://budget:budget@localhost:5432/budget_foyer"

# Chaine secrete utilisee pour signer les jetons de connexion (JWT).
# Génère la tienne avec: openssl rand -base64 48
JWT_SECRET="change-me-en-local-avec-une-valeur-aleatoire"

# Port d'ecoute de l'API
PORT=3001

# Origine autorisee pour les requetes du frontend (CORS)
WEB_ORIGIN="http://localhost:5173"
